<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<model type="com.apple.IDECoreDataModeler.DataModel" documentVersion="1.0" lastSavedToolsVersion="22522" systemVersion="24A335" minimumToolsVersion="Automatic" sourceLanguage="Swift" usedWithSwiftData="NO" userDefinedModelVersionIdentifier="">
    <!--
      Headline metrics are stored as indexed columns so the history list can
      sort and filter without deserialising anything. The rich per-rep detail
      lives in a one-to-one SessionDetail row as JSON, loaded only when a
      results screen actually opens.

      codeGenerationType="none": the NSManagedObject subclasses are written by
      hand in SessionStore.swift. Xcode's codegen would emit duplicate symbols
      because the project is generated by XcodeGen.
    -->
    <entity name="Session" representedClassName="SessionMO" syncable="YES" codeGenerationType="none">
        <attribute name="compensationEvents" optional="NO" attributeType="Integer 16" defaultValueString="0" usesScalarValueType="YES"/>
        <attribute name="date" optional="NO" attributeType="Date" usesScalarValueType="NO"/>
        <attribute name="durationSeconds" optional="NO" attributeType="Float" defaultValueString="0" usesScalarValueType="YES"/>
        <attribute name="exerciseType" optional="NO" attributeType="String" defaultValueString="custom"/>
        <attribute name="id" optional="NO" attributeType="UUID" usesScalarValueType="NO"/>
        <attribute name="qualityScore" optional="NO" attributeType="Float" defaultValueString="0" usesScalarValueType="YES"/>
        <attribute name="repCount" optional="NO" attributeType="Integer 16" defaultValueString="0" usesScalarValueType="YES"/>
        <attribute name="stabilityScore" optional="NO" attributeType="Float" defaultValueString="0" usesScalarValueType="YES"/>
        <relationship name="detail" optional="YES" maxCount="1" toMany="NO" deletionRule="Cascade" destinationEntity="SessionDetail" inverseName="session" inverseEntity="SessionDetail"/>
        <fetchIndex name="byDate">
            <fetchIndexElement property="date" type="Binary" order="descending"/>
        </fetchIndex>
        <uniquenessConstraints>
            <uniquenessConstraint>
                <constraint value="id"/>
            </uniquenessConstraint>
        </uniquenessConstraints>
    </entity>
    <entity name="SessionDetail" representedClassName="SessionDetailMO" syncable="YES" codeGenerationType="none">
        <attribute name="sessionId" optional="NO" attributeType="UUID" usesScalarValueType="NO"/>
        <attribute name="summaryJSON" optional="NO" attributeType="String" defaultValueString="{}"/>
        <relationship name="session" optional="YES" maxCount="1" toMany="NO" deletionRule="Nullify" destinationEntity="Session" inverseName="detail" inverseEntity="Session"/>
    </entity>
</model>
